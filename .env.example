# Backend URL the Vite dev proxy forwards `/api/*` to.
# Use the same origin in the app code (e.g. fetch("/api/v1/auth/me")) so
# cookies behave as same-origin in dev.
VITE_BACKEND_URL=http://localhost:4000

# Base path the frontend prepends to every API call. With the proxy above,
# leave this as `/api/v1`. Override only when calling the backend directly
# (e.g. for Storybook against a deployed env).
VITE_API_BASE_URL=/api/v1

# While the integration is incremental, keep mocks on by default and flip
# domains to "false" as their phase lands.
VITE_USE_MOCK_API=true
